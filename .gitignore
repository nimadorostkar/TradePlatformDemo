# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Claude Code local state (per-machine permissions, worktrees)
.claude/

# Local env / secrets — each package also ignores its own .env
.env
.env.local
.env.*.local

# Logs
*.log
.dev-logs/

# Sub-package specifics (node_modules, dist, bin,
# Go build outputs, …) are covered by frontend/.gitignore and backend/.gitignore.

# deployment artifacts (deploy/deploy.sh)
deploy/frontend-build/
deploy/gateway.env
deploy/frontend.env
deploy/.env
