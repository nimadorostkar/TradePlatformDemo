# Runtime configuration for the prebuilt terminal (read by
# frontend/deploy/entrypoint.sh at container start). deploy.sh writes
# frontend.env from this with __PUBLIC_ORIGIN__ substituted.
#
# APP_ENV=staging: the terminal is served over plain HTTP on an IP address,
# and both the entrypoint and the client refuse http:// gateway URLs under
# "production". Put a domain + TLS in front and switch to production.
APP_ENV=staging
GATEWAY_HTTP_URL=__PUBLIC_ORIGIN__/gateway
GATEWAY_WS_URL=__PUBLIC_WS_ORIGIN__/gateway
CRM_HTTP_URL=__PUBLIC_ORIGIN__/crm
CONFIRM_TRADES=true
ENABLE_ONE_CLICK_TRADING=false
ENABLE_LEGACY_AUTH_STORAGE=false
DEFAULT_TIMEZONE=Europe/Istanbul
APP_VERSION=__VERSION__
