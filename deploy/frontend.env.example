# Runtime configuration for the prebuilt terminal (read by
# frontend/deploy/entrypoint.sh at container start). deploy.sh writes
# frontend.env from this.
#
# The edge serves the terminal at / and proxies /gateway and /crm beside it,
# so the service URLs are same-origin PATHS: the terminal then works through
# whatever address reaches the edge — the server's IP, a domain in front of
# it, an SSH tunnel — instead of only the one origin compiled in.
#
# APP_ENV=staging: the terminal is served over plain HTTP on an IP address,
# and the client refuses a plaintext page under "production". Put a domain +
# TLS in front and switch to production.
APP_ENV=staging
GATEWAY_HTTP_URL=/gateway
GATEWAY_WS_URL=/gateway
CRM_HTTP_URL=/crm
CONFIRM_TRADES=true
ENABLE_ONE_CLICK_TRADING=false
ENABLE_LEGACY_AUTH_STORAGE=false
DEFAULT_TIMEZONE=Etc/UTC
APP_VERSION=__VERSION__
