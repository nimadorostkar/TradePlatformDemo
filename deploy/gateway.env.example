# Gateway configuration for the compose deployment. deploy.sh copies this to
# gateway.env on first deploy and fills the two __GENERATE__ values with fresh
# random secrets; later deploys leave gateway.env untouched.
#
# This platform is a DEMO. The gateway's only upstream is the `demomarket`
# service in the same compose project — real market data (Yahoo Finance, no
# key) behind the MT5 Manager API contract, plus a demo broker and CRM. There
# is no broker connection and no broker credential here.

ENVIRONMENT=production
TRADING_MODE=demo
HTTP_ADDR=:5063
METRICS_ADDR=127.0.0.1:9090
LOG_FORMAT=json

# ── Upstreams: demomarket ─────────────────────────────────────────────────
MT5_HOST_URL=http://demomarket
MT5_PORT=5199
MT5_LOGIN=1
MT5_PASSWORD=demo-password-not-a-secret
CRM_URL=http://demomarket:5199
CRM_ALLOWED_ACCOUNT_TYPES=11,57,58
CRM_ACCOUNT_TYPE_SUFFIXES=57:,58:,11:
CRM_DEMO_ACCOUNT_TYPES=11,57,58

# The instruments demomarket serves; the gateway's empty-search answer and
# its clock/history reference symbol come from this list.
MT5_DEFAULT_SYMBOL_LIST=EURUSD,GBPUSD,USDJPY,AUDUSD,USDCAD,USDCHF,NZDUSD,XAUUSD,BTCUSD,ETHUSD

# ── Tokens ───────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=__GENERATE__
JWT_ISSUER=https://tradeplatform.local
JWT_AUDIENCE=tradeplatform-clients
MANAGER_API_KEY=__GENERATE__

# ── Edge ─────────────────────────────────────────────────────────────────────
# The browser only ever talks to the edge origin (same-origin /gateway), so
# CORS is not exercised; listed for tools that call the gateway directly.
CORS_ALLOWED_ORIGINS=__PUBLIC_ORIGIN__
# Session cookies shared across the terminal's and the client area's
# subdomains (their common parent domain). deploy.sh keeps this line in step
# with TERMINAL_HOST / CLIENT_AREA_HOST; empty means host-only cookies.
SESSION_COOKIE_DOMAIN=
# `edge` forwards the client IP; trust only the compose network.
RATE_LIMIT_TRUSTED_PROXIES=172.30.0.0/24
RATE_LIMIT_RPS=50
RATE_LIMIT_BURST=100

# ── Demo broker ──────────────────────────────────────────────────────────────
# demomarket honours leverage changes; these are the choices the terminal offers.
LEVERAGE_CHOICES=50,100,200,500
