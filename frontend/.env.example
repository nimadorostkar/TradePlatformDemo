# Public client configuration.
#
# EVERYTHING in this file is compiled into the bundle and readable by anyone who
# loads the page. Never put an MT5 credential, a JWT signing key, a CRM
# password, or any service token here.
#
# Copy to `.env` for local development. Production values are injected at
# container start by deploy/entrypoint.sh, so one image serves every environment.

# development | staging | production
VITE_APP_ENV=development

# Go OpoMTSocket gateway. http/ws are DEVELOPMENT ONLY — the config validator
# refuses to start in production without https/wss.
VITE_GATEWAY_HTTP_URL=http://localhost:5063
VITE_GATEWAY_WS_URL=ws://localhost:5063

# Optional local-development proxy for a remote gateway that does not allow the
# localhost browser origin. In that case, set VITE_GATEWAY_HTTP_URL to
# http://localhost:3100/gateway and set this server-only target:
# DEV_GATEWAY_PROXY_TARGET=https://gateway.example.com

# CRM, used for login and the account list.
VITE_CRM_HTTP_URL=https://myaccount.opofinance.com

# Where the licensed TradingView library is served from. Populate the directory
# with `npm run tv:sync`.
VITE_TRADINGVIEW_LIBRARY_PATH=/charting_library/

# Optional: URL of a JSON broker branding document (see src/app/config/brand.ts).
# Falls back to neutral defaults if absent or invalid.
VITE_BRAND_CONFIG_URL=

VITE_DEFAULT_TIMEZONE=Europe/Istanbul

# Require a confirmation dialog before every trade. Leave on unless you have a
# specific reason not to.
VITE_CONFIRM_TRADES=true

# Allow traders to opt in to one-click trading. Even when true, the trader must
# still arm it explicitly per workspace.
VITE_ENABLE_ONE_CLICK_TRADING=false

# Mirror tokens into the legacy localStorage keys (`token`, `crm_token`) used by
# the existing TradingView integration.
#
# OFF by default and REFUSED in production — browser storage is readable by any
# script in the origin. See docs/architecture/frontend-architecture.md#auth-storage
VITE_ENABLE_LEGACY_AUTH_STORAGE=false

# Comma-separated origins permitted to bootstrap a session via postMessage, and
# permitted to frame the terminal. Empty means: no host embedding.
VITE_ALLOWED_HOST_ORIGINS=

# Shown in diagnostics; CI sets this to the commit SHA.
VITE_APP_VERSION=0.0.0-dev

# How long a stream may go without a frame before the UI marks it stale.
# The server pushes every ~3s, so the default is four cadences.
VITE_QUOTE_STALE_AFTER_MS=12000

# ── Contract smoke tests (opt-in, read-only) ─────────────────────────────────
# Used only by `npm run test:contract`. Point at a NON-PRODUCTION gateway.
# CONTRACT_GATEWAY_URL=
# CONTRACT_GATEWAY_TOKEN=
# CONTRACT_LOGIN=
