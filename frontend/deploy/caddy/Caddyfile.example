# The production host's TOP-LEVEL Caddyfile (C:\Caddy\Caddyfile on the Windows
# box), recorded here as it was live on 2026-09-04 with one secret redacted.
#
# This is NOT the file CI ships. CI ships opotrade-ui.caddy (the site
# configuration next to this file) and only when CADDY_CONFIG_PATH is set.
# The host's real Caddyfile carries things that site file cannot, and every
# one of them is load-bearing:
#
#   * the global options block — the Cloudflare `trusted_proxies` list the
#     gateway's per-client throttle depends on (HGH-02; see
#     opotrade-mt-socket-new/deploy/windows/apply-cloudflare-trusted-proxies.ps1)
#   * the /tv-artifact-<token>/ path that serves the licensed TradingView
#     tarball to CI credential-free (the token is the repository secret
#     TRADINGVIEW_ARTIFACT_URL — rotate both together)
#   * an unrelated monitoring origin on the same box
#   * `import C:/Caddy/sites/*.caddy`, through which the bare-IP origin is
#     served from C:\Caddy\sites\opotrade-ui-new.caddy
#
# On the host the stage site block is written INLINE below rather than
# imported from the site file, so a header or cache change has to be made in
# both places by hand until CADDY_CONFIG_PATH brings it under CI. Keep this
# file, opotrade-ui.caddy and deploy/nginx.conf saying the same thing.
#
# Validate and reload from cmd, not PowerShell 5.1 (its $ErrorActionPreference
# treats caddy's stderr info-logs as fatal):
#   cmd /c C:\Caddy\caddy.exe validate --config C:\Caddy\Caddyfile
#   cmd /c C:\Caddy\caddy.exe reload   --config C:\Caddy\Caddyfile
{
	servers {
		# Cloudflare's published ranges (https://www.cloudflare.com/ips/).
		# Without this Caddy drops the client hop from X-Forwarded-For and
		# every Cloudflare-proxied visitor reaches the gateway as one IP.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	}
	email admin@opofinance.com
}

opotrade-ui-stage.opofinance.com {
	# Content-hashed assets are immutable by construction: the Vite bundle
	# hashes its filenames and the TradingView bundles/ directory ships
	# hashed chunk names. Long-lived caching here is what lets a repeat
	# visit skip the 6.16 MB chart payload entirely (2026-08-24 chart-load
	# teardown). A missing file still falls through try_files to
	# index.html, whose own no-store header is applied later in the route
	# and wins for the rewritten request.
	@immutableAssets path /assets/* /charting_library/bundles/*
	header @immutableAssets Cache-Control "public, max-age=31536000, immutable"
	encode zstd gzip

	# Licensed TradingView artifact for CI, addressed by an unguessable
	# token so no SSH credential is involved in fetching it. The token
	# lives only in the repository secret TRADINGVIEW_ARTIFACT_URL.
	handle /tv-artifact-<48-hex-token>/tradingview.tar.gz {
		root * C:/sites/opotrade-ui-new/artifacts
		rewrite * /tradingview.tar.gz
		header Cache-Control no-store
		file_server
	}

	handle_path /gateway/* {
		reverse_proxy 127.0.0.1:5070
	}

	handle_path /crm/* {
		reverse_proxy https://myaccount.opofinance.com {
			header_up Host myaccount.opofinance.com
		}
	}

	handle {
		root * C:/sites/opotrade-ui-new/current
		route {
			try_files {path} /index.html
			@deploymentMetadata path / /index.html /runtime-config.js
			header @deploymentMetadata Cache-Control "no-cache, no-store, must-revalidate"
			file_server
		}
	}

	@health path /healthz
	header @health {
		Content-Type "application/json"
		Cache-Control "no-store"
	}

	@tradingViewFrame path /charting_library/sameorigin.html
	header @tradingViewFrame Content-Security-Policy "default-src 'self' blob: data:; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob: https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; child-src 'self' blob:; frame-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'self'"

	@applicationDocument {
		not path /charting_library/sameorigin.html
	}
	header @applicationDocument Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-eval' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://cloudflareinsights.com; worker-src 'self' blob:; child-src 'self' blob:; frame-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"

	header {
		Cross-Origin-Opener-Policy "same-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), unload=(self)"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		-Server
	}
}

# Bare proxy to the gateway for API clients that do not go through the UI
# origin. No cookie/CORS relaxation lives here; the gateway does its own.
opotrade-stage-backend.opofinance.com {
	encode zstd gzip
	reverse_proxy 127.0.0.1:5070
}

# Unrelated to the terminal: a monitoring dashboard that shares the box.
monitor.opofinance.com {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}
	reverse_proxy 127.0.0.1:4000
}

import C:/Caddy/sites/*.caddy
