# OpoMTSocket Go gateway production environment for Windows.
# Copy to C:\opomtsocket-go\gateway.env, fill placeholders, then run
# protect-config.ps1 before registering the Scheduled Task.
ENVIRONMENT=production
HTTP_ADDR=127.0.0.1:5070
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=120s
HTTP_MAX_BODY_BYTES=4194304
METRICS_ADDR=127.0.0.1:9090

JWT_SECRET_KEY=__SET_FROM_DOTNET_appsettings_Jwt_SecretKey__
# Turning either of these on also requires the matching value below: the binary
# carries no default issuer/audience, and validation-on with an empty value is
# a startup error rather than a silently unvalidated token.
JWT_VALIDATE_ISSUER=false
JWT_VALIDATE_AUDIENCE=false
#JWT_ISSUER=https://your-broker.example
#JWT_AUDIENCE=your-broker-clients

# e.g. https://tradeapp.your-broker.example
MT5_HOST_URL=__set_me__
MT5_PORT=443
MT5_LOGIN=__SET_FROM_DOTNET_MT5Config_login__
MT5_PASSWORD=__SET_FROM_DOTNET_MT5Config_password__
MT5_VERSION=4410
MT5_AGENT=WebManager
MT5_TYPE=Manager
MT5_REQUEST_TIMEOUT=30s
MT5_MAX_RESPONSE_BYTES=33554432
# e.g. https://myaccount.your-broker.example
CRM_URL=__set_me__

# ⚠️ DEPLOY-TIME BEHAVIOR CHANGE — read before removing 11,26.
# The value below reproduces the PREVIOUS behavior exactly ({11,26,57..67}).
# The code default is 57..67 only, because 11 and 26 have no confirmed symbol
# suffix. Removing them here is the intended end state, but do it deliberately:
# a trader whose ONLY accounts are type 11 or 26 gets a token with no accounts
# claim and is then 401'd on every protected endpoint — i.e. locked out.
# Confirm the suffix for 11/26, add it to CRM_ACCOUNT_TYPE_SUFFIXES, then
# tighten this list.
CRM_ALLOWED_ACCOUNT_TYPES=11,26,57,58,59,60,61,62,63,64,65,66,67
#
# typeId:suffix. Confirmed against the live broker on 2026-07-31 by reading each
# account's MT5 group and cross-checking the symbol namespace, where the same
# instrument exists under each suffix (AUDNOK. / AUDNOK! / AUDNOK#):
#
#   tier          suffix   typeIds   group name contains
#   ECN           .        57, 61    ECN-...
#   Standard      !        58, 62    STD-...
#   Social/COPY   #        60        COPY-...
#   ECNPRO        (none)   11,59,63  ECNPRO-...
#
# An EMPTY suffix is a real answer, not a missing one — that is why the code
# distinguishes "configured as empty" from "not configured".
#
# typeId 64 (group COPY-ECNPRO-APP-USD-B) is deliberately ABSENT: the group
# carries both the COPY and ECNPRO qualifiers, so its suffix is genuinely
# ambiguous. Leaving it out makes the client report suffixKnown:false and
# refuse to build symbol names for it — far better than guessing and sending a
# wrong symbol to MT5. Add it once the broker confirms.
CRM_ACCOUNT_TYPE_SUFFIXES=11:,57:.,58:!,59:,60:#,61:.,62:!,63:

WS_REQUIRE_AUTH=true
WS_ALLOW_QUERY_TOKEN=false
MANAGER_API_KEY=
# The duplicate /api/tv/TVOrder/* compatibility controller is not registered.
# Exact origins of the terminal(s) served by this deployment, comma separated.
# e.g. https://terminal.your-broker.example
CORS_ALLOWED_ORIGINS=__set_me__

TIMESCALE_DSN=postgres://opo:__SET_OPO_PASSWORD__@localhost:5432/market?sslmode=disable
POSTGRES_DSN=postgres://opo:__SET_OPO_PASSWORD__@localhost:5432/trading_ops?sslmode=disable
MT5_READ_DATA_FROM_DB=false

# Price alerts + workspace persistence use POSTGRES_DSN (falling back to
# TIMESCALE_DSN). On first start the gateway creates price_alerts and
# workspaces there — additive CREATE TABLE IF NOT EXISTS, no existing table is
# touched. With neither DSN set, both features report themselves off via
# GET /api/Capabilities instead of silently accepting data they cannot keep.
ALERTS_ENABLED=true
ALERTS_EVAL_INTERVAL=3s

# How long a trade submission carrying an Idempotency-Key can be replayed, so a
# client retrying a timed-out request cannot open a second position.
TRADE_IDEMPOTENCY_TTL=10m
# Market-depth side codes: mql5 (SELL=1,BUY=2) or manager (SELL=0,BUY=1).
# VERIFY THIS against a live book on first deploy: a wrong value flips every bid
# and ask, and shows up as "crossed":true from /api/Tick/get_marketdepth.
MT5_BOOK_SIDE_CONVENTION=mql5

# News / economic calendar. Empty URL = feature off, and the endpoint says why.
# The API key stays server-side and is never sent to the client.
NEWS_PROVIDER_URL=
NEWS_PROVIDER_API_KEY=
CALENDAR_PROVIDER_URL=
CALENDAR_PROVIDER_API_KEY=

# Redis is optional. Without it, the gateway uses per-process trade idempotency
# and rate limiting -- correct for one gateway process, but not cluster-wide.
# Install Redis and set REDIS_ADDRS for guarantees shared across replicas.

RATE_LIMIT_RPS=50
RATE_LIMIT_BURST=100
# Every reverse-proxy hop between the client and this gateway must be listed,
# or the X-Forwarded-For walk dead-ends and rate limiting + the login throttle
# fail open for those requests (logged hourly as "client IP not established").
# Behind Caddy behind Cloudflare that means: loopback (Caddy's peer address)
# plus Cloudflare's published ranges (https://www.cloudflare.com/ips/).
# EQUALLY REQUIRED: Caddy itself must trust Cloudflare (global option
# `servers { trusted_proxies static <cloudflare ranges> }`), or Caddy replaces
# the incoming XFF with the Cloudflare edge IP and the client hop is lost
# before this gateway ever sees it. Verified 2026-08-28: without the Caddy
# half, every user keyed to 127.0.0.1 — one shared login-throttle lockout for
# the whole site (HGH-02).
RATE_LIMIT_TRUSTED_PROXIES=127.0.0.1/32,::1/128,173.245.48.0/20,103.21.244.0/22,103.22.200.0/22,103.31.4.0/22,141.101.64.0/18,108.162.192.0/18,190.93.240.0/20,188.114.96.0/20,197.234.240.0/22,198.41.128.0/17,162.158.0.0/15,104.16.0.0/13,104.24.0.0/14,172.64.0.0/13,131.0.72.0/22,2400:cb00::/32,2606:4700::/32,2803:f800::/32,2405:b500::/32,2405:8100::/32,2a06:98c0::/29,2c0f:f248::/32
LOG_FORMAT=json
LOG_LEVEL=info
LOG_FILE=C:\opomtsocket-go\logs\gateway.log
LOG_MAX_SIZE_MB=50
LOG_MAX_BACKUPS=5
LOG_MAX_AGE_DAYS=14

# Bearer-token lifetime (Go duration syntax). Capped at 1h by startup
# validation: this JWT authorizes live trading with no revocation, so its
# lifetime is the blast radius of a stolen token. Long sessions come from
# renewal + SESSION_RESTORE_TTL below, not from a long-lived bearer.
JWT_EXPIRY=30m
# How long the HttpOnly session cookies survive: the window in which a
# returning browser restores its session without a password. GET /session
# re-mints an expired JWT from the cookie-held CRM token.
SESSION_RESTORE_TTL=720h

# ── Trader-adjustable leverage ───────────────────────────────────────────────
# The leverage values a trader may select, e.g. "25,50,100,200,500".
# EMPTY DISABLES THE FEATURE, and empty is the default.
#
# Leverage is a property of the MT5 user record and a BROKER policy: MT5 will
# not enumerate the permitted values, and it is not a per-symbol setting. Set
# this only once the broker has confirmed that traders may change their own
# leverage and which values are allowed. Until then the terminal reports the
# capability as unavailable and shows no control.
LEVERAGE_CHOICES=

# ── MT5 connection pool ──────────────────────────────────────────────────────
# How many authenticated MT5 Manager connections the gateway keeps.
#
# The code default is 1, chosen for exact parity with the .NET service's single
# pinned socket — but EVERY MT5 call in the gateway is serialised through the
# pool, each holding its connection for the whole round trip. A single account
# switch fires five REST calls plus a poll per new subscription, so at 1 they
# queue head to tail, and that queue is the largest part of the 45-55 second
# switch the 2026-08-24 launch-readiness report measured.
#
# Measured on production 2026-08-26, the five-call switch burst:
#   serialised (pool 1): 940 ms      concurrent (pool 3): 242 ms   → 3.9x
# With pool 3 the gateway logged `"pool_size":3,"authenticated":3` — this
# broker permits three concurrent manager sessions.
#
# Raising it opens that many more manager sessions, and a broker MAY cap them.
# The failure is visible rather than silent: each connection authenticates
# independently at startup and the gateway logs
#   {"msg":"mt5 manager started","pool_size":N,"authenticated":M}
# If M < N the broker refused the extras — lower this and restart.
MT5_POOL_SIZE=3

# ── Which accounts hold simulated funds ──────────────────────────────────────
# MT5 groups whose funds are DEMO, by EXACT full name, comma separated.
#
# Keyed on the GROUP, not the CRM account type, because this broker's types
# cannot express it: "ECN Pro" contains BOTH Opoforex\ECNPRO-USD-B (real) and
# Opoforex\ECNPRO-SF-USD-B (simulated). Classifying by type would badge real
# accounts as demo (measured 2026-08-26: 7 of them).
#
# Exact names rather than a "-SF-" substring: a renamed or newly added group
# drops out of an exact list and shows NO badge — visibly missing, and somebody
# asks. A substring keeps matching whatever it hits and mislabels in silence.
#
# Empty = classify nothing = no badge anywhere, which is the safe default and
# costs no lookups. Set, the gateway reads each account's group (cached 30 min).
CRM_DEMO_MT5_GROUPS=Opoforex\ECNPRO-SF-USD-B,Opoforex\HL-STD-APP-SF-USD-B,Opoforex\STD-APP-SF-USD-B,Opoforex\COPY-APP-SF-USD-B,Opoforex\HL-ECNPRO-APP-SF-USD-B,Opoforex\ECNPRO-APP-SF-USD-B,Opoforex\HL-ECN-APP-SF-USD-B,Opoforex\ECN-APP-SF-USD-B
