# Production env for the VPS, tuned to run ALONGSIDE the .NET gateway with
# IDENTICAL behavior (so existing clients keep working). Copy to .env.prod and
# fill the secrets. Tighten the "coexistence" settings AFTER the .NET service is
# retired (see the notes).
#
#   cp .env.prod.example .env.prod   &&   edit .env.prod

# ── Server ──────────────────────────────────────────────────────────────────
# Container listens on 5063 internally; compose maps host 5070 -> 5063.
HTTP_ADDR=:5063
# 'production' makes missing secrets fatal at startup (fail fast).
ENVIRONMENT=production

# ── MT5 (real broker — the VPS IP is whitelisted) ───────────────────────────
# e.g. https://tradeapp.your-broker.example
MT5_HOST_URL=__set_me__
MT5_PORT=443
# The MT5 manager account this gateway authenticates as.
MT5_LOGIN=__set_me__
MT5_PASSWORD=__copy_from_dotnet_appsettings__
MT5_VERSION=4410
MT5_AGENT=WebManager
MT5_TYPE=Manager
MT5_POOL_SIZE=1

# ── CRM ─────────────────────────────────────────────────────────────────────
# e.g. https://myaccount.your-broker.example
CRM_URL=__set_me__

# ── JWT — reuse the .NET secret so a token works on BOTH gateways ───────────
JWT_SECRET_KEY=__copy_from_dotnet_appsettings_Jwt_SecretKey__
# Coexistence: .NET tokens have no iss/aud, so DON'T validate them (else Go
# would reject .NET-issued tokens). Set both true after .NET is retired — and
# set JWT_ISSUER/JWT_AUDIENCE at the same time, because the binary carries no
# default for them and validation-on with an empty value refuses to start.
JWT_VALIDATE_ISSUER=false
JWT_VALIDATE_AUDIENCE=false
#JWT_ISSUER=https://your-broker.example
#JWT_AUDIENCE=your-broker-clients
# Bearer-token lifetime (Go duration syntax). Capped at 1h by startup
# validation: this JWT authorizes live trading with no revocation, so its
# lifetime is the blast radius of a stolen token. Long sessions come from
# renewal + SESSION_RESTORE_TTL below, not from a long-lived bearer.
JWT_EXPIRY=30m
# How long the HttpOnly session cookies survive: the window in which a
# returning browser restores its session without a password. GET /session
# re-mints an expired JWT from the cookie-held CRM token.
SESSION_RESTORE_TTL=720h

# ── Behavior parity with .NET (coexistence) ─────────────────────────────────
# The .NET service: unauthenticated /ws, any CORS origin. (The username-only
# login path is removed for good — login is always CRM-backed.)
# Match it so existing clients keep working. HARDEN these after cutover:
#   WS_REQUIRE_AUTH=true, CORS_ALLOWED_ORIGINS=<allowlist>
WS_REQUIRE_AUTH=false
CORS_ALLOWED_ORIGINS=*

# ── API-only: no DB/Redis/NATS for the first launch ─────────────────────────
TIMESCALE_DSN=
MT5_READ_DATA_FROM_DB=false
RATE_LIMIT_RPS=0
# Even with the volume limiter off (RPS=0), the login throttle (HGH-02) stays
# on and shares this keyer. Behind Caddy+Cloudflare, leaving it empty keys
# every sign-in to the proxy's IP — one shared, site-wide lockout. Trust
# loopback plus Cloudflare's ranges so the gateway keys on the real client.
# Ranges: https://www.cloudflare.com/ips/ (re-check if Cloudflare republishes).
RATE_LIMIT_TRUSTED_PROXIES=127.0.0.1/32,::1/128,173.245.48.0/20,103.21.244.0/22,103.22.200.0/22,103.31.4.0/22,141.101.64.0/18,108.162.192.0/18,190.93.240.0/20,188.114.96.0/20,197.234.240.0/22,198.41.128.0/17,162.158.0.0/15,104.16.0.0/13,104.24.0.0/14,172.64.0.0/13,131.0.72.0/22,2400:cb00::/32,2606:4700::/32,2803:f800::/32,2405:b500::/32,2405:8100::/32,2a06:98c0::/29,2c0f:f248::/32
NATS_URL=

# ── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FORMAT=json
