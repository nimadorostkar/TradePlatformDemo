# syntax=docker/dockerfile:1
# The in-repo MT5 Manager API + CRM stand-in (cmd/demomarket), as a container
# for deployments that have no broker credentials. Same wire contract as the
# real upstreams; every answer is canned.

FROM golang:1.26.6 AS build
WORKDIR /src
COPY go.mod go.sum* ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/demomarket ./cmd/demomarket

FROM gcr.io/distroless/static-debian12:nonroot
WORKDIR /app
COPY --from=build /out/demomarket /app/demomarket
EXPOSE 5199
USER nonroot:nonroot
ENTRYPOINT ["/app/demomarket", "-addr", ":5199"]
