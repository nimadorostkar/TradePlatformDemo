# Local full-stack development against the in-repo mock MT5 + CRM
# (scripts/mockmt5). Nothing here is a secret and nothing here can reach a
# broker: MT5_HOST_URL and CRM_URL both point at the mock. Started for you by
# `make dev` at the repository root; or by hand:
#
#   go run ./scripts/mockmt5 -addr 127.0.0.1:5199
#   set -a; . .env.mock; set +a; go run ./cmd/gateway
#
# For a real broker use .env (gitignored) — see .env.example.

ENVIRONMENT=development
HTTP_ADDR=127.0.0.1:5063
METRICS_ADDR=127.0.0.1:9090

MT5_HOST_URL=http://127.0.0.1
MT5_PORT=5199
MT5_LOGIN=1
MT5_PASSWORD=mock-password-not-a-secret
CRM_URL=http://127.0.0.1:5199

JWT_SECRET_KEY=local-dev-only-key-not-a-secret-0123456789abcdef
JWT_ISSUER=https://issuer.local.invalid
JWT_AUDIENCE=local-clients

# The Vite dev server is the browser origin; it proxies /gateway and /crm to
# the two upstreams same-origin (frontend/vite.config.ts), so this list is
# only needed for tools that call the gateway directly from a page.
CORS_ALLOWED_ORIGINS=http://localhost:3100,http://127.0.0.1:3100

MANAGER_API_KEY=local000000000000000000000000000000
RATE_LIMIT_RPS=0

# The mock CRM returns accounts of types 57, 58 and 11. The gateway reports an
# account as tradable only when its type's symbol suffix is declared here, and
# the mock serves un-suffixed symbols, so all three map to the empty suffix.
CRM_ALLOWED_ACCOUNT_TYPES=11,57,58
CRM_ACCOUNT_TYPE_SUFFIXES=57:,58:,11:
