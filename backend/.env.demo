# Local development against the built-in demomarket service (cmd/demomarket):
# real market prices from Yahoo Finance plus a demo broker and CRM, speaking
# the MT5 Manager API contract. This platform is a DEMO: nothing here is a
# secret and nothing here can reach a broker — MT5_HOST_URL and CRM_URL point
# at demomarket on localhost.
# Started for you by `make dev` at the repository root; or by hand:
#
#   go run ./cmd/demomarket -addr 127.0.0.1:5199
#   set -a; . .env.demo; set +a; go run ./cmd/gateway

ENVIRONMENT=development
TRADING_MODE=demo
HTTP_ADDR=127.0.0.1:5063
METRICS_ADDR=127.0.0.1:9090

# ── Upstreams: demomarket ─────────────────────────────────────────────────
MT5_HOST_URL=http://127.0.0.1
MT5_PORT=5199
MT5_LOGIN=1
MT5_PASSWORD=demo-password-not-a-secret
CRM_URL=http://127.0.0.1:5199

# demomarket's CRM returns accounts of types 57, 58 and 11 — all demo funds
# — and serves un-suffixed symbols, so every type maps to the empty suffix.
CRM_ALLOWED_ACCOUNT_TYPES=11,57,58
CRM_ACCOUNT_TYPE_SUFFIXES=57:,58:,11:
CRM_DEMO_ACCOUNT_TYPES=11,57,58

# The instruments demomarket serves; the gateway's empty-search answer and
# its clock/history reference symbol come from this list.
MT5_DEFAULT_SYMBOL_LIST=EURUSD,GBPUSD,USDJPY,AUDUSD,USDCAD,USDCHF,NZDUSD,XAUUSD,BTCUSD,ETHUSD

# ── Tokens (placeholders, local only) ───────────────────────────────────────
JWT_SECRET_KEY=local-dev-only-key-not-a-secret-0123456789abcdef
JWT_ISSUER=https://issuer.local.invalid
JWT_AUDIENCE=local-clients
MANAGER_API_KEY=local000000000000000000000000000000

# The Vite dev server is the browser origin; it proxies /gateway and /crm
# same-origin (frontend/vite.config.ts), so CORS is only for direct calls.
CORS_ALLOWED_ORIGINS=http://localhost:3100,http://127.0.0.1:3100
RATE_LIMIT_RPS=0
